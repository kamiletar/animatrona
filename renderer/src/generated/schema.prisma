    /// @form.title("Закрытие окна в трей")
    /// @form.fieldType("switch")
    /// @form.description("При нажатии на крестик сворачивать в трей вместо закрытия")
    closeToTray Boolean @default(true)
    /// @form.title("Показывать уведомление при сворачивании")
    /// @form.fieldType("switch")
    /// @form.description("Показывать уведомление при первом сворачивании в трей")
    showTrayNotification Boolean @default(true)
    /// @form.title("Тёмная тема")
    /// @form.fieldType("switch")
    darkMode Boolean @default(true)
    /// @form.title("Язык интерфейса")
    /// @form.fieldType("select")
    /// @form.props({ options: ["ru", "en", "ja"] })
    language String @default("ru")
    /// @form.title("Автопропуск опенинга")
    /// @form.fieldType("switch")
    skipOpening Boolean @default(false)
    /// @form.title("Автопропуск эндинга")
    /// @form.fieldType("switch")
    skipEnding Boolean @default(false)
    /// @form.title("Автовоспроизведение")
    /// @form.fieldType("switch")
    autoplay Boolean @default(true)
    /// @form.title("Предпочтение дорожек")
    /// @form.fieldType("radioCard")
    /// @form.description("Какие дорожки выбирать автоматически при первом просмотре")
    trackPreference TrackPreference @default(AUTO)
    /// @form.exclude
    /// Профиль кодирования по умолчанию
    defaultProfileId String?
    defaultProfile EncodingProfile? @relation(fields: [defaultProfileId], references: [id], onDelete: SetNull)
    /// @form.title("Мобильный доступ")
    /// @form.fieldType("switch")
    /// @form.description("Доступ к библиотеке с мобильных устройств в локальной сети")
    mobileAccessEnabled Boolean @default(false)
    /// @form.title("Порт мобильного сервера")
    /// @form.fieldType("numberInput")
    /// @form.props({ min: 1024, max: 65535 })
    /// @form.description("HTTP порт для мобильного доступа")
    mobileServerPort Int @default(4000)
    updatedAt DateTime @updatedAt()
}

/// Профиль кодирования
model EncodingProfile {
    id String @id() @default(cuid())
    /// @form.title("Название")
    /// @form.placeholder("Например: Blackwell UHQ")
    name String
    /// Встроенный или пользовательский
    isBuiltIn Boolean @default(false)
    /// @form.title("Профиль по умолчанию")
    /// @form.fieldType("switch")
    isDefault Boolean @default(false)
    /// @form.title("Видеокодек")
    /// @form.fieldType("radioCard")
    codec VideoCodec @default(AV1)
    /// @form.title("Использовать GPU")
    /// @form.fieldType("switch")
    useGpu Boolean @default(true)
    /// @form.title("Rate Control")
    /// @form.fieldType("radioCard")
    rateControl RateControl @default(VBR)
    /// @form.title("Качество (CQ/CRF)")
    /// @form.fieldType("slider")
    /// @form.props({ min: 15, max: 40, showValue: true })
    /// @form.description("Меньше = лучше качество, больше размер")
    cq Int @default(28)
    /// @form.title("Макс. битрейт (Mbps)")
    /// @form.fieldType("numberInput")
    /// @form.props({ min: 1, max: 100 })
    /// @form.description("Для VBR режима")
    maxBitrate Int?
    /// @form.title("Пресет скорости")
    /// @form.fieldType("select")
    /// @form.props({ options: ["p1", "p2", "p3", "p4", "p5", "p6", "p7"] })
    preset String @default("p5")
    /// @form.title("Tune")
    /// @form.fieldType("radioCard")
    tune Tune @default(HQ)
    /// @form.title("Multipass")
    /// @form.fieldType("radioCard")
    multipass Multipass @default(DISABLED)
    /// @form.title("Spatial AQ")
    /// @form.fieldType("switch")
    /// @form.description("Улучшает качество плоских областей")
    spatialAq Boolean @default(true)
    /// @form.title("Temporal AQ")
    /// @form.fieldType("switch")
    /// @form.description("Адаптирует качество для движущихся сцен")
    temporalAq Boolean @default(true)
    /// @form.title("AQ Strength")
    /// @form.fieldType("slider")
    /// @form.props({ min: 1, max: 15, showValue: true })
    aqStrength Int @default(8)
    /// @form.title("Lookahead Frames")
    /// @form.fieldType("slider")
    /// @form.props({ min: 0, max: 250, showValue: true })
    /// @form.description("Количество кадров для анализа (0 = авто)")
    lookahead Int?
    /// @form.title("Lookahead Level")
    /// @form.fieldType("slider")
    /// @form.props({ min: 0, max: 3, showValue: true })
    lookaheadLevel Int?
    /// @form.title("GOP Size")
    /// @form.fieldType("numberInput")
    /// @form.props({ min: 1, max: 600 })
    /// @form.description("Расстояние между ключевыми кадрами")
    gopSize Int @default(240)
    /// @form.title("B-Ref Mode")
    /// @form.fieldType("radioCard")
    bRefMode BRefMode @default(DISABLED)
    /// @form.title("Принудительно 10-bit")
    /// @form.fieldType("switch")
    /// @form.description("Выводить 10-bit даже для 8-bit источника")
    force10Bit Boolean @default(false)
    /// @form.title("Temporal Filter")
    /// @form.fieldType("switch")
    /// @form.description("Blackwell+ только: +4-5% качества при движении")
    temporalFilter Boolean @default(false)
    /// @form.title("Предпочитать CPU")
    /// @form.fieldType("switch")
    /// @form.description("Принудительно использовать libsvtav1 вместо NVENC")
    preferCpu Boolean @default(false)
    /// @form.title("Deband фильтр")
    /// @form.fieldType("switch")
    /// @form.description("Убирает banding в градиентах (может вызывать краши на тяжёлых файлах)")
    deband Boolean @default(true)
    settings Settings[]
    episodes Episode[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@index([isBuiltIn])
    @@index([isDefault])
}

/// Элемент очереди импорта
/// Хранит настройки из wizard'а для последовательной обработки
model ImportQueueItem {
    id String @id() @default(cuid())
    /// Статус обработки
    status ImportQueueItemStatus @default(PENDING)
    /// Приоритет (меньше = раньше)
    priority Int @default(0)
    /// Время добавления в очередь
    addedAt DateTime @default(now())
    /// Время начала обработки
    startedAt DateTime?
    /// Время завершения
    completedAt DateTime?
    /// JSON с полными данными ImportQueueEntry (folderPath, selectedAnime, files, etc.)
    dataJson String
    /// Сообщение об ошибке (если status = ERROR)
    error String?
    /// Прогресс обработки (0-100)
    progress Int @default(0)
    /// Текущий обрабатываемый файл
    currentFileName String?
    /// ID созданного аниме в БД (для отката при ошибке)
    createdAnimeId String?
    /// Путь к папке аниме в библиотеке (для отката)
    createdAnimeFolder String?

    @@index([status])
    @@index([priority])
    @@index([addedAt])
}

/// Подписка на библиотеку другого пользователя (P2P Sharing)
model Subscription {
    id String @id() @default(cuid())
    /// IPNS имя (PeerId) владельца библиотеки
    ipnsName String @unique()
    /// Имя для отображения (задаётся пользователем)
    displayName String
    /// Последний известный CID библиотеки
    lastKnownCid String?
    /// Когда последний раз проверяли обновления
    lastCheckedAt DateTime?
    /// Автоматически пиннить контент из этой подписки
    autoPin Boolean @default(false)
    /// Лимит автопининга в байтах (0 = без лимита)
    autoPinLimit Int @default(0)
    /// Дата создания подписки
    createdAt DateTime @default(now())
    /// Дата обновления
    updatedAt DateTime @updatedAt()

    @@index([ipnsName])
    @@index([lastCheckedAt])
}

/// Удалённый трекер в федеративной сети
model Tracker {
    id String @id() @default(cuid())
    /// URL трекера (уникальный идентификатор)
    url String @unique()
    /// Название трекера
    name String
    /// Описание трекера
    description String?
    /// Тема контента (anime, drama, movie и т.д.)
    theme String @default("anime")
    /// Основной язык контента
    language String @default("ru")
    /// PEM-кодированный публичный ключ для верификации подписей
    publicKeyPem String?
    /// Уровень доверия
    trustLevel TrustLevel @default(UNTRUSTED)
    /// Процент uptime (0-100)
    uptimePercent Float @default(0)
    /// Среднее время ответа в мс
    avgResponseTimeMs Int @default(0)
    /// Качество контента (0-1)
    contentQuality Float @default(0)
    /// Количество успешных синхронизаций
    successfulSyncs Int @default(0)
    /// Количество неудачных синхронизаций
    failedSyncs Int @default(0)
    /// Количество синхронизированного контента
    contentSynced Int @default(0)
    /// Последняя успешная синхронизация
    lastSyncAt DateTime?
    /// Последняя проверка доступности
    lastCheckedAt DateTime?
    /// Импортированный контент
    importedContent FederatedContent[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@index([trustLevel])
    @@index([lastSyncAt])
    @@index([lastCheckedAt])
}

/// Федеративный контент — импортированный из другого трекера
model FederatedContent {
    id String @id() @default(cuid())
    /// Трекер-источник
    trackerId String
    tracker Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
    /// ID контента на удалённом трекере
    remoteId String
    /// Связь с локальным аниме (если было импортировано)
    animeId String?
    anime Anime? @relation(fields: [animeId], references: [id], onDelete: SetNull)
    /// JSON данные VideoSeriesObject
    contentJson String
    /// MyAnimeList ID
    malId Int?
    /// AniList ID
    anilistId Int?
    /// Shikimori ID
    shikimoriId Int?
    /// AniDB ID
    anidbId Int?
    /// Когда был получен контент
    receivedAt DateTime @default(now())
    /// Когда был обновлён
    updatedAt DateTime @updatedAt()

    @@unique([trackerId, remoteId])
    @@index([trackerId])
    @@index([animeId])
    @@index([malId])
    @@index([anilistId])
    @@index([shikimoriId])
}

/// Настройки федерации (singleton)
model FederationSettings {
    id String @id() @default("default")
    /// Федерация включена
    enabled Boolean @default(false)
    /// Название этого трекера в сети
    trackerName String @default("My Animatrona")
    /// Описание этого трекера
    trackerDescription String?
    /// Тема контента (anime, drama, movie)
    theme String @default("anime")
    /// Основной язык контента
    language String @default("ru")
    /// Автоматическая синхронизация с доверенными трекерами
    autoSync Boolean @default(true)
    /// Интервал автосинхронизации в минутах
    syncIntervalMinutes Int @default(60)
    /// Минимальный trust level для автоимпорта (1=UNTRUSTED, 2=KNOWN, 3=TRUSTED, 4=VERIFIED)
    minTrustForAutoImport Int @default(3)
    /// Приватный ключ RSA-2048 (PEM, зашифрован)
    privateKeyPem String?
    /// Публичный ключ RSA-2048 (PEM)
    publicKeyPem String?
    updatedAt DateTime @updatedAt()
}

/// Статистика пользователя (singleton)
model UserStats {
    id String @id() @default("default")
    /// Всего байт загружено (upload)
    bytesUploaded BigInt @default(0)
    /// Всего байт скачано (download)
    bytesDownloaded BigInt @default(0)
    /// Общее время раздачи в мс
    totalSeedingTimeMs BigInt @default(0)
    /// Время текущей сессии раздачи в мс
    currentSessionMs BigInt @default(0)
    /// Количество уникального контента (CID), который раздаётся
    uniqueContentSeeded Int @default(0)
    /// Общее количество пиров, которым помогли
    peersHelped Int @default(0)
    /// Дата первой раздачи
    firstSeedAt DateTime?
    /// Дата последней активности
    lastActiveAt DateTime @default(now())
    /// Дневная статистика
    dailyStats DailyStats[]
    updatedAt DateTime @updatedAt()
}

/// Дневная статистика
model DailyStats {
    id String @id() @default(cuid())
    /// Связь с UserStats
    userStatsId String @default("default")
    userStats UserStats @relation(fields: [userStatsId], references: [id], onDelete: Cascade)
    /// Дата в формате YYYY-MM-DD
    date String
    /// Байты загружено (upload)
    bytesUploaded BigInt @default(0)
    /// Байты скачано (download)
    bytesDownloaded BigInt @default(0)
    /// Время раздачи в мс
    seedingTimeMs BigInt @default(0)
    /// Количество уникальных пиров, которым помогли
    peersHelped Int @default(0)

    @@unique([userStatsId, date])
    @@index([date])
}

/// Репутация пользователя (singleton)
model UserReputation {
    id String @id() @default("default")
    /// Общий score (0-100)
    score Int @default(0)
    /// Текущий ранг
    rank UserRank @default(NEWCOMER)
    /// Score за соотношение upload/download (0-30)
    ratioScore Int @default(0)
    /// Score за время раздачи (0-25)
    seedingTimeScore Int @default(0)
    /// Score за количество уникального контента (0-20)
    uniqueContentScore Int @default(0)
    /// Score за помощь пирам (0-15)
    helpedPeersScore Int @default(0)
    /// Score за время в сообществе (0-10)
    longevityScore Int @default(0)
    updatedAt DateTime @updatedAt()
}

/// Разблокированное достижение пользователя
model UserAchievement {
    id String @id() @default(cuid())
    /// ID достижения (из enum AchievementId)
    achievementId String
    /// Дата получения
    unlockedAt DateTime @default(now())
    /// Было ли показано уведомление
    notified Boolean @default(false)

    @@unique([achievementId])
    @@index([unlockedAt])
}

/// Прогресс достижения
model AchievementProgress {
    id String @id() @default(cuid())
    /// ID достижения
    achievementId String @unique()
    /// Прогресс (0-100)
    progress Int @default(0)
    updatedAt DateTime @updatedAt()
}

/// Бонусные очки пользователя (singleton)
model UserBonusPoints {
    id String @id() @default("default")
    /// Текущий баланс
    balance Int @default(0)
    /// Всего заработано
    totalEarned Int @default(0)
    /// Всего потрачено
    totalSpent Int @default(0)
    /// История транзакций
    transactions BonusTransaction[]
    updatedAt DateTime @updatedAt()
}

/// Транзакция бонусных очков
model BonusTransaction {
    id String @id() @default(cuid())
    /// Связь с UserBonusPoints
    bonusPointsId String @default("default")
    bonusPoints UserBonusPoints @relation(fields: [bonusPointsId], references: [id], onDelete: Cascade)
    /// Тип транзакции
    type BonusTransactionType
    /// Сумма (положительная для начисления, отрицательная для траты)
    amount Int
    /// Баланс после транзакции
    balanceAfter Int
    /// Описание
    description String
    /// Метаданные в JSON (achievementId, contentCid, itemId, multipliers)
    metadataJson String?
    createdAt DateTime @default(now())

    @@index([type])
    @@index([createdAt])
}

/// Профиль пользователя для P2P синхронизации (singleton)
/// Заменяет OrbitDB UserProfileDB — хранится в SQLite, публикуется через IPNS
model LocalUserProfile {
    id String @id() @default("default")
    /// PeerId ноды (из Kubo или Helia)
    peerId String
    /// Friend Code (XXXX-XXXX) для добавления в друзья
    friendCode String @unique()
    /// Отображаемое имя
    displayName String @default("Анонимус")
    /// URL аватара (data URL, IPFS CID или внешний URL)
    avatarUrl String?
    /// Цвет аватара (для генерации дефолтного)
    avatarColor String?
    /// Статус (пользовательский текст)
    status String?
    /// IPNS ключ для публикации профиля (CID последней публикации)
    ipnsPublishedCid String?
    /// Время последней IPNS публикации
    ipnsPublishedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()
}

/// Друг в P2P сети
/// Хранит информацию о принятых друзьях для PresenceSync
model Friend {
    /// PeerId друга (уникальный идентификатор)
    peerId String @id()
    /// Friend Code друга
    friendCode String
    /// Отображаемое имя
    displayName String
    /// URL аватара
    avatarUrl String?
    /// Онлайн-статус
    isOnline Boolean @default(false)
    /// JSON-encoded WatchingInfo (что смотрит)
    watchingJson String?
    /// Последний раз видели онлайн
    lastSeenAt DateTime?
    /// Когда стали друзьями
    friendsSince DateTime @default(now())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@index([isOnline])
}

/// Запрос в друзья (входящий/исходящий)
model FriendRequest {
    id String @id() @default(cuid())
    /// PeerId отправителя
    fromPeerId String
    /// Friend Code отправителя
    fromFriendCode String
    /// Имя отправителя
    fromDisplayName String
    /// PeerId получателя
    toPeerId String
    /// Статус: pending, accepted, rejected, blocked
    status String @default("pending")
    /// Время отправки
    sentAt DateTime @default(now())
    /// Время ответа
    respondedAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@index([fromPeerId, toPeerId, status])
    @@index([toPeerId, status])
}