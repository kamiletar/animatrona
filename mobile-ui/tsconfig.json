{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lena/video-player-react": ["../../../libs/video-player-react/src/index.ts"],
      "@lena/video-player-core": ["../../../libs/video-player-core/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../../libs/video-player-react"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
